# Copie para .env.local e preencha. Supabase: Project Settings → API Keys.

# URL do projeto Supabase (ex.: https://abcdefgh.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (publishable/anon). Vai para o navegador; a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (secret/service_role). Só no servidor; nunca exponha nem commite.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: endereço público do app, usado no link de agendamento que o dono
# divulga. Sem ela, usa o host da requisição.
NEXT_PUBLIC_SITE_URL=

# Opcional: Cloudflare Turnstile (captcha) no cadastro e no agendamento.
# Preencha as duas para ativar; vazias, o fluxo segue sem captcha.
# Chave do site (aparece no navegador).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Chave secreta (verificação no servidor).
TURNSTILE_SECRET_KEY=

# Opcional: WhatsApp do suporte (com DDD, só números). Aparece na tela
# Plano e indicação para o dono contratar ou mudar de plano.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
